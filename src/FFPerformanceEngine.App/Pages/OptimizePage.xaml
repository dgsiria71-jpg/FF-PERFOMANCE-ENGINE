r candidatos" Click="Generate_Click"/></StackPanel></Grid></Border><Border Style="{StaticResource GlassCard}"><StackPanel><TextBlock Text="Resultado" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ResultText" Text="Nenhuma medição executada." TextWrapping="Wrap"/><ProgressBar x:Name="Progress" Height="7" Margin="0,14,0,0" Minimum="0" Maximum="100" Value="0"/></StackPanel></Border></StackPanel></ScrollViewer></UserControl>