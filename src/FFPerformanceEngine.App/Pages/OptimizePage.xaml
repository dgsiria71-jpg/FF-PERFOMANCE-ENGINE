<UserControl x:Class="FFPerformanceEngine.App.Pages.OptimizePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ChoiceCard" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource GlassBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GlassStrongBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="6,12,12,24">
            <Grid Margin="4,0,4,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Auto Tuner" FontSize="34" FontWeight="SemiBold"/>
                    <TextBlock Text="Meça, valide e encontre os melhores perfis para este computador."
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="14" Margin="0,7,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="16,10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Benchmark híbrido · rollback automático" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Modo de otimização" Style="{StaticResource SectionTitle}" Margin="4,0,0,12"/>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="AdaptiveModeButton" Style="{StaticResource ChoiceCard}" Click="AdaptiveMode_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ADAPTATIVO" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Explora rápido, repete medições e aprofunda somente onde existe ganho real."
                                       Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,14,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="◎" FontSize="30" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button x:Name="DeepModeButton" Grid.Column="2" Style="{StaticResource ChoiceCard}" Click="DeepMode_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PROFUNDO" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Exploração ampla, mais repetições e confiança maior. Ideal para uma calibração completa."
                                       Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,14,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="◉" FontSize="30" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </Grid>

            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="1.6*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="JOGO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="FreeFireButton" Content="Free Fire" Padding="12,7" Click="FreeFire_Click"/>
                            <Button x:Name="FreeFireMaxButton" Content="Free Fire MAX" Padding="12,7" Margin="8,0,0,0" Click="FreeFireMax_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="INSTÂNCIA BLUESTACKS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                        <ComboBox x:Name="InstanceCombo" MinHeight="32" Margin="0,10,0,0" SelectionChanged="InstanceCombo_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="BENCHMARK" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="Híbrido · medição real + validação repetida" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBlock Text="Nenhum perfil é escolhido sem evidência de frame-time."
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Prontidão" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ReadinessStatusText" Text="Analisando o sistema..." FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBlock x:Name="ReadinessDetailText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,28,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock x:Name="InstanceStatusText" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock Text="  ·  " Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock x:Name="TelemetryStatusText" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock Text="  ·  " Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock x:Name="CandidateCountText" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Width="250" VerticalAlignment="Center">
                        <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="INICIAR OTIMIZAÇÃO" Click="Start_Click" MinHeight="48"/>
                        <Button x:Name="CancelButton" Content="Cancelar com segurança" Click="Cancel_Click" MinHeight="38" Margin="0,8,0,0" Visibility="Collapsed"/>
                        <CheckBox x:Name="KeepDeepCheck" Content="Manter Profundo como padrão" Margin="3,12,0,0" Checked="KeepDeepCheck_Changed" Unchecked="KeepDeepCheck_Changed"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="RunCard" Style="{StaticResource GlassCard}" Margin="0,0,0,18" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="StageLabelText" Text="Preparando" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock x:Name="RunTitleText" Text="Otimizando seu sistema" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock x:Name="RunDetailText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,7,20,0"/>
                        <ProgressBar x:Name="RunProgress" Height="9" Minimum="0" Maximum="100" Margin="0,18,20,0"/>
                        <TextBlock x:Name="ProgressPercentText" Text="0%" Foreground="{DynamicResource MutedTextBrush}" Margin="0,7,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource GlassStrongBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="24" Width="116" Height="116" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="AUTO" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="RunPercentHero" Text="0%" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="ResultCard" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="OTIMIZAÇÃO CONCLUÍDA" Foreground="{DynamicResource SuccessBrush}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="Perfil recomendado" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            <TextBlock x:Name="ResultSummaryText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,24,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="16" Padding="14,8" VerticalAlignment="Top">
                            <TextBlock x:Name="PersistenceStatusText" Text="VALIDADO" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </Grid>

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="FPS" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/><TextBlock x:Name="ResultFpsText" Style="{StaticResource MetricValue}" Text="—"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="1% LOW" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/><TextBlock x:Name="ResultLowText" Style="{StaticResource MetricValue}" Text="—"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="FRAME TIME" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/><TextBlock x:Name="ResultFrameTimeText" Style="{StaticResource MetricValue}" Text="—"/></StackPanel>
                        <StackPanel Grid.Column="3"><TextBlock Text="LATÊNCIA" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/><TextBlock x:Name="ResultLatencyText" Style="{StaticResource MetricValue}" Text="—"/></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="CONFIANÇA" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/><TextBlock x:Name="ResultConfidenceText" Style="{StaticResource MetricValue}" Text="—"/></StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource GlassStrongBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock x:Name="RecommendedConfigText" FontWeight="SemiBold"/>
                            <TextBlock x:Name="WinnersText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
