<UserControl x:Class="FFPerformanceEngine.App.Pages.GuardianPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="GuardianPage_Loaded"
             Unloaded="GuardianPage_Unloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <TextBlock Text="Performance Guardian" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="Observe mais do que altera. Meça tudo que alterar. Reverta tudo que não melhorar."
                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,18"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource GlassCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock x:Name="StateText" Text="● Observando" FontSize="30" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SessionText" Text="Aguardando sessão" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource HoverBrush}" CornerRadius="12" Padding="12,7">
                                <TextBlock x:Name="ModeText" Text="Adaptativo" FontWeight="SemiBold"/>
                            </Border>
                        </DockPanel>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource HoverBrush}" CornerRadius="16" Padding="14" Margin="0,0,6,0">
                                <StackPanel><TextBlock Text="FPS" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="FpsText" Text="—" Style="{StaticResource MetricValue}" Margin="0,4,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource HoverBrush}" CornerRadius="16" Padding="14" Margin="6,0">
                                <StackPanel><TextBlock Text="1% Low" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="OneLowText" Text="—" Style="{StaticResource MetricValue}" Margin="0,4,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource HoverBrush}" CornerRadius="16" Padding="14" Margin="6,0">
                                <StackPanel><TextBlock Text="Frame Time" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="FrameTimeText" Text="—" Style="{StaticResource MetricValue}" Margin="0,4,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="3" Background="{DynamicResource HoverBrush}" CornerRadius="16" Padding="14" Margin="6,0,0,0">
                                <StackPanel><TextBlock Text="Latência" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="LatencyText" Text="—" Style="{StaticResource MetricValue}" Margin="0,4,0,0"/></StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="SESSÃO" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="Jogo" Margin="0,0,18,8"/><TextBlock x:Name="GameText" Grid.Column="1" Text="—" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="1" Text="Instância" Margin="0,0,18,8"/><TextBlock x:Name="InstanceText" Grid.Row="1" Grid.Column="1" Text="—" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="2" Text="PID" Margin="0,0,18,8"/><TextBlock x:Name="PidText" Grid.Row="2" Grid.Column="1" Text="—" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="3" Text="Qualidade" Margin="0,0,18,0"/><TextBlock x:Name="DataQualityText" Grid.Row="3" Grid.Column="1" Text="—" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="REFERÊNCIA VALIDADA" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="Baseline" Margin="0,0,18,8"/><TextBlock x:Name="BaselineText" Grid.Column="1" Text="—" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="1" Text="Confiança" Margin="0,0,18,8"/><TextBlock x:Name="BaselineConfidenceText" Grid.Row="1" Grid.Column="1" Text="—" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="2" Text="Decisão" Margin="0,0,18,0"/><TextBlock x:Name="DecisionConfidenceText" Grid.Row="2" Grid.Column="1" Text="—" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Border Background="{DynamicResource HoverBrush}" CornerRadius="16" Padding="16" Margin="0,22,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Intervenção" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="InterventionText" Text="Nenhuma" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBlock x:Name="DecisionText" Text="Aguardando evidência da sessão." TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Comportamento" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="GuardianEnabledToggle" Content="Guardian ativo" Margin="0,0,0,16"
                                  Checked="GuardianEnabled_Changed" Unchecked="GuardianEnabled_Changed"/>

                        <TextBlock Text="Instância BlueStacks" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="InstanceCombo" SelectionChanged="InstanceCombo_Changed" Margin="0,0,0,16"/>
                        <TextBlock x:Name="InstanceHintText" Text="Detectando instâncias..." TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,-8,0,16"/>

                        <TextBlock Text="Modo" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ModeCombo" SelectionChanged="ModeCombo_Changed">
                            <ComboBoxItem Content="Conservador" Tag="Conservative"/>
                            <ComboBoxItem Content="Adaptativo" Tag="Adaptive"/>
                            <ComboBoxItem Content="Agressivo" Tag="Aggressive"/>
                            <ComboBoxItem Content="Monitorar apenas" Tag="MonitorOnly"/>
                        </ComboBox>

                        <Border Background="{DynamicResource HoverBrush}" CornerRadius="16" Padding="14" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="Política de segurança" FontWeight="SemiBold"/>
                                <TextBlock Text="Durante a partida, somente ações LiveSafe podem ser executadas. Sem evidência suficiente, o Guardian apenas observa."
                                           TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
