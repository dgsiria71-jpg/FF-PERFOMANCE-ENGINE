<UserControl x:Class="FFPerformanceEngine.App.Pages.GuardianPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Margin="4"><TextBlock Text="Performance Guardian" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Observe mais do que altera. Meça tudo que alterar. Reverta tudo que não melhorar." Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource GlassCard}" Margin="0,0,8,0"><StackPanel><TextBlock x:Name="StateText" Text="● Estável" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="ModeText" Text="Adaptativo" Margin="0,8,0,0"/><TextBlock x:Name="DecisionText" Text="Nenhuma intervenção necessária." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,12,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Comportamento" Style="{StaticResource SectionTitle}"/><ComboBox x:Name="ModeCombo" SelectionChanged="ModeCombo_Changed"><ComboBoxItem Content="Conservative"/><ComboBoxItem Content="Adaptive" IsSelected="True"/><ComboBoxItem Content="Aggressive"/><ComboBoxItem Content="MonitorOnly"/></ComboBox><Button Style="{StaticResource PrimaryButton}" Content="Simular avaliação" Click="Evaluate_Click" Margin="0,14,0,0"/></StackPanel></Border></Grid></StackPanel></ScrollViewer></UserControl>