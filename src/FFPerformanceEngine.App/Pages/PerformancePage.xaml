<UserControl x:Class="FFPerformanceEngine.App.Pages.PerformancePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Margin="4"><TextBlock Text="Performance" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Telemetria real e qualidade dos dados." Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource GlassCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="CPU"/><TextBlock x:Name="CpuText" Text="—" Style="{StaticResource MetricValue}"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="8,0"><StackPanel><TextBlock Text="RAM"/><TextBlock x:Name="RamText" Text="—" Style="{StaticResource MetricValue}"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource GlassCard}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Frame Provider"/><TextBlock x:Name="ProviderText" Text="—" Style="{StaticResource MetricValue}" FontSize="18"/></StackPanel></Border></Grid><Border Style="{StaticResource GlassCard}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Captura real" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="CaptureText" Text="Use PresentMon para FPS, 1% low e latência de display. Valores indisponíveis permanecem indisponíveis, nunca simulados." TextWrapping="Wrap"/><Button Style="{StaticResource PrimaryButton}" Content="Medir 10 segundos" Click="Measure_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></UserControl>