<UserControl x:Class="FFPerformanceEngine.App.Pages.PerformancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <TextBlock Text="Performance" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="Telemetria medida do processo BlueStacks vinculado pelo Guardian. Valores ausentes permanecem indisponíveis."
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,18" />

            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Alvo de medição" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="TargetText" Text="Aguardando vínculo exato do Guardian" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="TargetDetailText" Text="Nenhum PID é escolhido automaticamente por aproximação."
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="MeasureButton" Grid.Column="1" Style="{StaticResource PrimaryButton}"
                            Content="Medir 10 segundos" Click="Measure_Click" VerticalAlignment="Center" Margin="20,0,0,0" />
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,7,0">
                    <StackPanel><TextBlock Text="FPS" /><TextBlock x:Name="FpsText" Text="—" Style="{StaticResource MetricValue}" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="7,0">
                    <StackPanel><TextBlock Text="1% LOW" /><TextBlock x:Name="OneLowText" Text="—" Style="{StaticResource MetricValue}" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource GlassCard}" Margin="7,0">
                    <StackPanel><TextBlock Text="FRAME TIME" /><TextBlock x:Name="FrameTimeText" Text="—" Style="{StaticResource MetricValue}" /></StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource GlassCard}" Margin="7,0,0,0">
                    <StackPanel><TextBlock Text="LATÊNCIA" /><TextBlock x:Name="LatencyText" Text="—" Style="{StaticResource MetricValue}" /></StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Evidência de frame" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <StackPanel Margin="0,0,12,14"><TextBlock Text="0.1% Low" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="PointOneLowText" Text="—" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,14"><TextBlock Text="Stutter" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="StutterText" Text="—" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,12,0"><TextBlock Text="P95 Frame Time" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="P95Text" Text="—" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="P99 Frame Time" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="P99Text" Text="—" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Qualidade dos dados" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="DataQualityText" Text="—" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="CaptureDetailText" Text="Nenhuma captura realizada nesta sessão."
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="FPS medido" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Cada linha representa somente evidência contínua. FPS ausente ou lacunas temporais interrompem o traçado em vez de serem interpolados."
                                       Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="20,0,0,0">
                            <Button x:Name="SessionWindowButton" Content="Sessão" Click="SessionWindow_Click" Margin="0,0,8,0" Padding="14,8" />
                            <Button x:Name="RecentWindowButton" Content="Últimos 60 s" Click="RecentWindow_Click" Padding="14,8" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="GraphRangeText" Text="Sem intervalo" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="PinBaselineButton" Content="Fixar baseline" Click="PinBaseline_Click" Padding="14,8" Margin="0,0,8,0" />
                            <Button x:Name="ClearBaselineButton" Content="Limpar baseline" Click="ClearBaseline_Click" Padding="14,8" IsEnabled="False" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource HoverBrush}" CornerRadius="16" Margin="0,14,0,0" Padding="8">
                        <Canvas x:Name="FpsGraphCanvas" Height="220" ClipToBounds="True" SizeChanged="FpsGraphCanvas_SizeChanged" />
                    </Border>
                    <TextBlock x:Name="GraphStatusText" Text="Nenhuma evidência de FPS nesta sessão."
                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0"><TextBlock Text="FPS médio" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="IntervalAverageFpsText" Text="—" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="Frame Time médio" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="IntervalFrameTimeText" Text="—" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                        <StackPanel Grid.Column="2" Margin="12,0"><TextBlock Text="Evidência" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="IntervalEvidenceText" Text="0/0 amostras com FPS" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel Grid.Column="3" Margin="12,0,0,0"><TextBlock Text="Eventos" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="IntervalEventsText" Text="Guardian 0 · Marcadores 0" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource HoverBrush}" CornerRadius="14" Padding="14" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Comparação com baseline" FontWeight="SemiBold" />
                                <TextBlock x:Name="BaselineStatusText" Text="Nenhum baseline fixado."
                                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="18,0"><TextBlock Text="Δ FPS médio" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="BaselineFpsDeltaText" Text="—" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                            <StackPanel Grid.Column="2" Margin="18,0,0,0"><TextBlock Text="Δ Frame Time" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="BaselineFrameTimeDeltaText" Text="—" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Timeline sincronizada" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Capturas medidas, mudanças relevantes do Guardian e marcadores manuais na mesma linha do tempo."
                                       Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="MarkMomentButton" Grid.Column="1" Content="Marcar momento"
                                Click="MarkMoment_Click" Margin="20,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="TimelineCountText" Text="0 eventos nesta sessão"
                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,14,0,8" />
                    <TextBlock x:Name="TimelineText" Text="Nenhum evento sincronizado ainda."
                               TextWrapping="Wrap" LineHeight="22" />
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="CPU" /><TextBlock x:Name="CpuText" Text="—" Style="{StaticResource MetricValue}" /></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="8,0"><StackPanel><TextBlock Text="RAM" /><TextBlock x:Name="RamText" Text="—" Style="{StaticResource MetricValue}" /></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource GlassCard}" Margin="8,0,0,0"><StackPanel><TextBlock Text="FRAME PROVIDER" /><TextBlock x:Name="ProviderText" Text="—" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel></Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
