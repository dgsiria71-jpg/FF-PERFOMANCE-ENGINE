<UserControl x:Class="FFPerformanceEngine.App.Pages.PromotedWinnerProvenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Border Background="{DynamicResource HoverBrush}"
            CornerRadius="12" Padding="12" Margin="0,8,0,0">
        <StackPanel>
            <TextBlock x:Name="WinnerText"
                       FontSize="15" FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="IdentityText"
                       Margin="0,6,0,0"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="CandidateText"
                       Margin="0,6,0,0" FontFamily="Consolas"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
