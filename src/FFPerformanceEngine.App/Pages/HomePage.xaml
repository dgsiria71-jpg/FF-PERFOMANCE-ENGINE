<UserControl x:Class="FFPerformanceEngine.App.Pages.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4"><Border Style="{StaticResource GlassCard}" Padding="28" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ReadyTitle" Text="Analisando ambiente..." FontSize="34" FontWeight="SemiBold"/><TextBlock x:Name="ReadySubtitle" Text="Verificando Windows, BlueStacks e telemetria." Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0" FontSize="14"/><StackPanel Orientation="Horizontal" Margin="0,18,0,0"><TextBlock x:Name="OsBadge" Margin="0,0,18,0"/><TextBlock x:Name="BlueStacksBadge" Margin="0,0,18,0"/><TextBlock x:Name="GameBadge"/></StackPanel></StackPanel><Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Otimizar agora  →" VerticalAlignment="Center" Click="Optimize_Click"/></Grid></Border><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="FPS" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="FpsValue" Text="—" Style="{StaticResource MetricValue}"/><TextBlock x:Name="FpsHint" Text="Aguardando medição" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="8,0"><StackPanel><TextBlock Text="1% Low" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="LowValue" Text="—" Style="{StaticResource MetricValue}"/><TextBlock Text="Consistência" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource GlassCard}" Margin="8,0"><StackPanel><TextBlock Text="Latência" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="LatencyValue" Text="—" Style="{StaticResource MetricValue}"/><TextBlock Text="Display/Frame" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel></Border><Border Grid.Column="3" Style="{StaticResource GlassCard}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Sistema" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="CpuValue" Text="—" Style="{StaticResource MetricValue}"/><TextBlock x:Name="MemoryValue" Text="Memória indisponível" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel></Border></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource GlassCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Perfil ativo" Style="{StaticResource SectionTitle}"/><TextBlock Text="★ Recomendado" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="O perfil só recebe métricas quando há evidência medida." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Performance Guardian" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="GuardianValue" Text="● Ativo · Adaptativo" FontSize="18"/><TextBlock Text="Observa mais do que altera. Mudanças Live Safe exigem evidência." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0"/></StackPanel></Border></Grid></StackPanel></ScrollViewer></UserControl>