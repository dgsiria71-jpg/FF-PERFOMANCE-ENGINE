<UserControl x:Class="FFPerformanceEngine.App.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Margin="4"><TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Aparência, Guardian, Auto Tuner e Mini Mode." Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,18"/><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource GlassCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/><RadioButton x:Name="CleanRadio" Content="Clean · Liquid Glass azul claro" GroupName="Theme" Margin="0,5" Checked="Theme_Changed"/><RadioButton x:Name="DarkRadio" Content="Dark · smoked glass + rubi" GroupName="Theme" Margin="0,5" Checked="Theme_Changed"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Auto Tuner" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="DeepDefault" Content="Sempre usar Profundo" Click="Settings_Changed"/><TextBlock Text="Adaptive continua disponível manualmente." Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0"/></StackPanel></Border></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource GlassCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Mini Mode + ARGB" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="ArgbCheck" Content="Borda ARGB ativada" Click="Settings_Changed"/><ComboBox x:Name="MiniSize" Margin="0,10,0,0" SelectionChanged="Settings_Changed"><ComboBoxItem Content="Compact"/><ComboBoxItem Content="Mini"/><ComboBoxItem Content="Micro"/></ComboBox><TextBlock Text="A borda ARGB permanece nos temas Clean e Dark." Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Frame telemetry" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="PresentMonText" Text="Verificando..."/><Button Style="{StaticResource PrimaryButton}" Content="Abrir pasta de ferramentas" Click="Tools_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/><TextBlock Text="Instalação automatizada: scripts/Get-PresentMon.ps1" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0"/></StackPanel></Border></Grid></StackPanel></ScrollViewer></UserControl>