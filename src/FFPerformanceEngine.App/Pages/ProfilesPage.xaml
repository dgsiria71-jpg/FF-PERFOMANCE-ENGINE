<UserControl x:Class="FFPerformanceEngine.App.Pages.ProfilesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Margin="4"><TextBlock Text="Perfis" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Vencedores validados e perfis personalizados." Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,18"/><Border Style="{StaticResource GlassCard}" Margin="0,0,0,14"><StackPanel><TextBlock Text="★ Recomendado" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="RecommendedText" Text="Ainda não há um perfil Recomendado validado." FontSize="18"/><TextBlock Text="O perfil só aparece como vencedor depois de evidência real." Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0"/></StackPanel></Border><ItemsControl x:Name="ProfilesList"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource GlassCard}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Evidence}" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding Confidence, StringFormat=Confiança {0:P0}}"/></StackPanel><Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Usar perfil" Click="ApplyProfile_Click" Tag="{Binding Id}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></UserControl>