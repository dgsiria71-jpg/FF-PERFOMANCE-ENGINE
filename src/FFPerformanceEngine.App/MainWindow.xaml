<Window x:Class="FFPerformanceEngine.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FF Performance Engine" Width="1280" Height="820" MinWidth="1040" MinHeight="680" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="{DynamicResource WindowBackgroundBrush}">
 <Border CornerRadius="28" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Background="{DynamicResource WindowBackgroundBrush}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" CornerRadius="28,0,0,28" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="8,10,8,28"><TextBlock Text="FF" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Performance Engine" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="BlueStacks · Free Fire" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
   <StackPanel Grid.Row="1"><Button Style="{StaticResource NavButton}" Content="⌂  Home" Tag="Home" Click="Navigate_Click"/><Button Style="{StaticResource NavButton}" Content="⚡  Optimize" Tag="Optimize" Click="Navigate_Click"/><Button Style="{StaticResource NavButton}" Content="★  Profiles" Tag="Profiles" Click="Navigate_Click"/><Button Style="{StaticResource NavButton}" Content="◈  Guardian" Tag="Guardian" Click="Navigate_Click"/><Button Style="{StaticResource NavButton}" Content="⌁  Performance" Tag="Performance" Click="Navigate_Click"/><Button Style="{StaticResource NavButton}" Content="≡  Expert" Tag="Expert" Click="Navigate_Click"/><Button Style="{StaticResource NavButton}" Content="◷  History" Tag="History" Click="Navigate_Click"/><Button Style="{StaticResource NavButton}" Content="⚙  Settings" Tag="Settings" Click="Navigate_Click"/></StackPanel>
   <StackPanel Grid.Row="2" Margin="8"><Button Style="{StaticResource PrimaryButton}" Content="Mini Mode" Click="MiniMode_Click"/><TextBlock Text="Observe. Meça. Reverta." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="2,12,0,0"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><TextBlock x:Name="PageTitle" Text="Home" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="28,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"><Button Style="{StaticResource NavButton}" Content="—" Width="42" HorizontalContentAlignment="Center" Click="Minimize_Click"/><Button Style="{StaticResource NavButton}" Content="□" Width="42" HorizontalContentAlignment="Center" Click="Maximize_Click"/><Button Style="{StaticResource NavButton}" Content="×" Width="42" HorizontalContentAlignment="Center" Click="Close_Click"/></StackPanel></Grid><ContentControl Grid.Row="1" x:Name="ContentHost" Margin="18,0,24,24"/></Grid>
 </Grid></Border>
</Window>
