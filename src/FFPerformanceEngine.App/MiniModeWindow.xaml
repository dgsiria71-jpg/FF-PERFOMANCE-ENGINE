<Window x:Class="FFPerformanceEngine.App.MiniModeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="620" Height="300" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False"><Window.Resources><Storyboard x:Key="ArgbStoryboard" RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="ArgbRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:6"/></Storyboard></Window.Resources><Border x:Name="ArgbBorder" CornerRadius="28" Padding="2"><Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><LinearGradientBrush.RelativeTransform><RotateTransform x:Name="ArgbRotate" CenterX="0.5" CenterY="0.5"/></LinearGradientBrush.RelativeTransform><GradientStop Color="#4AE8FF" Offset="0"/><GradientStop Color="#765CFF" Offset="0.22"/><GradientStop Color="#FF4FC7" Offset="0.45"/><GradientStop Color="#FFB548" Offset="0.66"/><GradientStop Color="#62E78E" Offset="0.84"/><GradientStop Color="#4AE8FF" Offset="1"/></LinearGradientBrush></Border.BorderBrush><Border.BorderThickness>2</Border.BorderThickness><Border Background="{DynamicResource GlassStrongBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="26" Padding="18" MouseLeftButtonDown="Drag_MouseLeftButtonDown"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="FF" FontWeight="Bold" FontSize="19" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="  Performance Engine" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock x:Name="StateText" Text="● BlueStacks" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/><Button Style="{StaticResource NavButton}" Content="—" Click="Collapse_Click"/><Button Style="{StaticResource NavButton}" Content="×" Click="Close_Click"/></StackPanel></Grid><Grid Grid.Row="1" Margin="0,16,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FPS" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="FpsText" Text="—" Style="{StaticResource MetricValue}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Latência" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="LatencyText" Text="—" Style="{StaticResource MetricValue}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="CPU" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="CpuText" Text="—" Style="{StaticResource MetricValue}"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="GPU" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="—" Style="{StaticResource MetricValue}"/></StackPanel></Grid><Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="★ Perfil: Recomendado" FontWeight="SemiBold"/><TextBlock Grid.Column="1" x:Name="GuardianText" Text="● Guardian Ativo" HorizontalAlignment="Right"/></Grid><Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Style="{StaticResource PrimaryButton}" Content="Boost Agora" Margin="0,0,6,0" Click="Boost_Click"/><Button Grid.Column="1" Style="{StaticResource NavButton}" Content="Trocar Perfil" Margin="6,0" Click="Profile_Click"/><Button Grid.Column="2" Style="{StaticResource NavButton}" Content="Deep Scan" Margin="6,0" Click="Deep_Click"/><Button Grid.Column="3" Style="{StaticResource NavButton}" Content="Mid-Game" Margin="6,0,0,0" Click="MidGame_Click"/></Grid></Grid></Border></Border></Window>